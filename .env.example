# ============================================================================
# Laboratorio de banca on-premise con Check Point AI Guardrails.
# make token lo crea como .env; el .env no se versiona y queda con permisos 600.
# ============================================================================

# --- LLM: gemini (API key de Google AI Studio) u openai ----------------------
LLM_PROVIDER=gemini

# Gemini: API key de Google AI Studio. Confirma el nombre del modelo con
# `make modelos` antes de levantar (lista los modelos que tu clave puede usar).
GOOGLE_API_KEY=
MODEL_ORCHESTRATOR=gemini-3.8-flash
MODEL_SPECIALIST=gemini-3.8-flash
MODEL_KNOWLEDGE=gemini-3.8-flash

# OpenAI: con LLM_PROVIDER=openai. Los MODEL_* van sin prefijo, con el nombre
# exacto que devuelve `make modelos` (el codigo antepone "openai/").
OPENAI_API_KEY=

# --- Perfil de comportamiento: vulnerable (demostracion) o endurecido ---------
PERFIL_AGENTE=vulnerable

# --- Check Point AI Guardrails ------------------------------------------------
LAKERA_GUARD_API_KEY=
LAKERA_PROJECT_ID=
# auto = respeta el Project mode del portal (Detect/Enforce)
LAKERA_MODO=auto

# --- Puente: token Bearer de la consola (make token lo genera) ---------------
# Si el 8080 esta ocupado en el host, cambia PUENTE_PUERTO.
PUENTE_TOKEN=
PUENTE_BIND=0.0.0.0
PUENTE_PUERTO=8080

# --- PostgreSQL (make token tambien genera esta clave) -------------------------
DB_PASSWORD=
